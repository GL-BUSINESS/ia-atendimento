# Só NOMES (nunca valores secretos). Copie para .env (ignorado pelo git) e preencha localmente.
# Banco ia_atendimento (S4), login ia_app_a ou ia_app_b: postgresql://USUARIO:SENHA@HOST:PORTA/ia_atendimento
DATABASE_URL=
# Modelo (estudo G §3): DeepSeek V4.1 Flash versão 1017, hospedado só nos EUA. Nunca a API oficial da DeepSeek; nada da Anthropic.
MODELO_NOME=deepseek-v4p1-flash-1017
MODELO_BASE_URL_1=https://us.api.fireworks.ai/inference/v1
MODELO_API_KEY_1=
# Roteador SÓ-EUA do Fireworks (obrigatório terminar em -us e ser o do MODELO_NOME)
MODELO_ROTEADOR=accounts/fireworks/routers/deepseek-v4p1-flash-1017-us
# Como desligar o raciocínio no extra_body: reasoning_effort_none (padrão) ou thinking_disabled. HIPÓTESE até a A2.9 medir no V4.1 Flash
MODELO_RACIOCINIO_OFF=reasoning_effort_none
# Chamada ao modelo: temperatura, tokens de saída e tempo de UMA chamada em s (máx. 10; sem retentativa do SDK, nunca um segundo provedor)
MODELO_TEMPERATURA=0.3
MODELO_MAX_TOKENS=400
MODELO_TIMEOUT_S=8
# Tokens da API por origem (X-IA-Token), JSON {"n8n_braco": "...", "ti": "...", "c360_api": "...", "vigia": "..."}; cada um >= 32 caracteres e diferente dos outros
API_TOKENS=
# Phoenix (observabilidade, banco ia_obs); vazio = sem exportar traces
PHOENIX_ENDPOINT=
# Projeto no Phoenix e, se ele exigir, a chave da API (segredo: só no .env, nunca no git)
PHOENIX_PROJETO=ia-atendimento
PHOENIX_API_KEY=
# Chave AES-256-GCM da conversa e do cofre: id vigente (mensal) e arquivo 0600 {"<id>": "<base64 de 32 bytes>"}
CHAVE_AES_ID=
CHAVE_AES_ARQUIVO=
# Chaves HMAC da identidade da mensagem recebida (>= 32 caracteres, DIFERENTES entre si, permanentes: trocar quebra o dedupe)
CHAVE_H16=
CHAVE_FINGERPRINT=
# HMAC do candidato.chat_ref (>= 32 caracteres, diferente das duas de cima, permanente)
CHAT_REF_CHAVE=
# Arquivos 0600 montados :ro (nunca env do Coolify): chaves HMAC do gateway (1 ou 2, uma por linha) e segredos de saída (JSON)
GATEWAY_HMAC_ARQUIVO=
SEGREDOS_SAIDA_ARQUIVO=
# E-mail do Amado no ChatGuru: responsavel_email diferente dele no evento marca delegacao_externa
RESPONSAVEL_IA=
# pessoas_teste (B2.4): JSON {"pessoas": [uuid], "chats": {chat_id: uuid}}; vazio = ninguém é de teste.
# Gere com: python -m ia_atendimento.pessoas_teste arquivo --par <chat 24 hex>=<persona> --saida <arquivo 0600>  (kit config/chats-teste.sh)
PESSOAS_TESTE_ARQUIVO=
# Casamento webhook x RPA (segundos) e preços do custo (USD por 1M de tokens; câmbio em BRL); vazio = padrão do código
CASAMENTO_JANELA_S=
CASAMENTO_JANELA_SEM_HORA_S=
PRECO_IN_USD=
PRECO_CACHE_USD=
PRECO_OUT_USD=
CAMBIO=
PRECO_TEMPLATE_BRL=
