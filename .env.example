# Só NOMES (nunca valores secretos). Copie para .env (ignorado pelo git) e preencha localmente.
# Banco ia_atendimento (S4), login ia_app_a ou ia_app_b: postgresql://USUARIO:SENHA@HOST:PORTA/ia_atendimento
DATABASE_URL=
# Modelo (estudo G §3): DeepSeek V4.1 Flash versão 1017, hospedado só nos EUA. Nunca a API oficial da DeepSeek; nada da Anthropic.
MODELO_NOME=deepseek-v4p1-flash-1017
MODELO_BASE_URL_1=https://us.api.fireworks.ai/inference/v1
MODELO_API_KEY_1=
# Token da API de entrada do orquestrador
API_TOKEN=
# Phoenix (observabilidade, banco ia_obs); vazio = sem exportar traces
PHOENIX_ENDPOINT=
# Chave AES-256-GCM da conversa e do cofre: id vigente (mensal) e arquivo 0600 {"<id>": "<base64 de 32 bytes>"}
CHAVE_AES_ID=
CHAVE_AES_ARQUIVO=
# Chaves HMAC da identidade da mensagem recebida (>= 32 caracteres, DIFERENTES entre si, permanentes: trocar quebra o dedupe)
CHAVE_H16=
CHAVE_FINGERPRINT=
