# Configuração do kit da S5 — só NOMES e valores NÃO secretos. Copie para /etc/ia-s5-adm/s5.env (root, 0600) e preencha.
# Formato estrito: NOME=valor, sem $, crase, ;, |, &, < ou > (o kit recusa). Segredo NUNCA entra aqui: vai por arquivo/stdin (50-segredos.sh).
# Cada linha vazia que o dono precisa decidir está marcada [DONO].

# --- Onde ficam os bancos ia_atendimento e ia_obs (DEC-PIA-009) [DONO]: s5 (PostgreSQL na própria S5) ou s4 (cluster gl360, padrão de 29/10)
BANCO_LOCAL=

# --- Acesso de administração
ADMIN_USUARIO=danilo
# arquivo com as chaves PÚBLICAS de quem administra (uma por linha: Danilo e o dono) [DONO]
ADMIN_CHAVES_ARQUIVO=/etc/ia-s5-adm/admin.pub
# SSH além do tailscale0: IPs/CIDRs públicos de emergência separados por vírgula (vazio = só pelo tailnet e pelo wg0 da S2) [DONO]
SSH_ORIGENS=
# Tailscale: arquivo 0600 com a chave de autenticação (opcional; sem ele o dono faz `tailscale up` à mão)
TAILSCALE_AUTHKEY_ARQUIVO=/etc/ia-s5-adm/tailscale.authkey
# janela de reversão do firewall, em segundos (memória firewall-remoto-caminho-de-volta)
FIREWALL_JANELA_S=180
# a S5 recebe IPv4 por DHCP? [DONO] sim abre SÓ a renovação no uplink, para o IP dela ou broadcast; IP fixo = nao
FIREWALL_DHCP=nao
FIREWALL_UPLINK=
# IP do servidor DHCP do provedor (opcional; restringe ainda mais)
FIREWALL_DHCP_SERVIDOR=

# --- WireGuard (rede 10.90.0.0/24 da S2/S4). Recomendação: a S5 herda o IP da VPS (10.90.0.5) e os contratos 01/02 não mudam de número.
WG_PORTA=51820
WG_IP_S5=
WG_IP_S2=10.90.0.2
# chave pública e endpoint ip:porta da S2 (o dono copia de `wg show wg0` na S2) [DONO]
WG_PUB_S2=
WG_ENDPOINT_S2=
# só com BANCO_LOCAL=s4
WG_IP_S4=10.90.0.4
WG_PUB_S4=
WG_ENDPOINT_S4=

# --- Aplicação (compose da esteira)
IA_PORTA=8000
IA_UID=10001
IA_SEGREDOS_DIR=/etc/ia-s5
# registro de imagens da S3 (host:porta, alcançado pelo tailnet) e o usuário de LEITURA [DONO]; a senha vai em /etc/ia-s5-adm/registro.senha
IA_REGISTRO_IMAGEM=
REGISTRO_USUARIO=
# id da chave AES do mês corrente: 1 = out/2026, 2 = nov/2026, 3 = dez/2026 (conversa.chave_id_do_mes). Vazio = o kit calcula pelo relógio UTC.
CHAVE_AES_ID=

# --- PostgreSQL na S5 (só BANCO_LOCAL=s5)
PG_VERSAO=18
PG_PORTA=5432
# a S2 lê ia_atendimento como ia_leitura_a (contrato 03): sim abre a porta no wg0 só para WG_IP_S2, com TLS e certificado de cliente
PG_LEITURA_S2=sim
# memória: ajuste à RAM informada pelo dono (≈ 25 % da RAM livre depois do orquestrador e do Phoenix)
PG_SHARED_BUFFERS=512MB
PG_MAX_CONNECTIONS=100

# --- Banco na S4 (só BANCO_LOCAL=s4): onde o kit s4 (distribuir-certs.sh) entregou certificados e senhas na S5
S4_ENTREGA_DIR=/etc/ia-s4
S4_PG_PORTA=5434

# --- Backup cifrado (só BANCO_LOCAL=s5) para o HDD da S3, com fila local [DONO: destino e chave pública age]
# destino ssh (pelo tailnet), diretório lá, e a chave PÚBLICA age (age1...) cuja privada fica com o dono, fora da S5 e fora da S3
BACKUP_DESTINO=
BACKUP_DESTINO_DIR=/mnt/hdd/backups/ia-s5
BACKUP_AGE_DESTINATARIO=
BACKUP_BANCOS=ia_atendimento
BACKUP_RETENCAO_LOCAL_DIAS=3
BACKUP_FILA_MAX_HORAS=26
BACKUP_FILA_DIR=/var/backups/ia-s5

# --- Alerta (DEC-PIA-010): ntfy.sh público com tópico secreto em /etc/ia-s5-adm/ntfy.topico (0600). Nunca dado pessoal na mensagem.
NTFY_URL_BASE=https://ntfy.sh
