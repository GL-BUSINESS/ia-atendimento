 "regras": {
  "chave": "chave(parte...) = int(sha256('|'.join([semente_global, *partes]))[:16], 16); tudo em ia_atendimento.corpus",
  "ordem_personas": "P01..P60 ordenadas por (chave('ordem', id), id); ordem_f3_curta é a mesma ordem filtrada pelas 40",
  "sementes_de_execucao": "sementes[id][k-1] = chave('execucao', id, k) % 2**31, k = 1..3 (3 execuções por persona; vale para P-M também)",
  "escolha_da_variacao": "índice = chave('variacao', id, execucao, indice_do_turno) % (1 + len(variacoes)); 0 = texto_cliente",
  "holdout": "20%: 8 das 40 da F3 curta e 4 das 20 restantes; em cada grupo, 1 persona por classe (a de menor chave('holdout', id)) e fica(m) a(s) classe(s) de menor chave('holdout-classe', classe); avaliado à parte e uma vez por versão",
  "reproduzir": "uv run python -m ia_atendimento.corpus  (recalcula tudo e compara com este arquivo)"
 }
